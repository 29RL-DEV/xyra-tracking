# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the running application.
# Local development against the bundled PostgreSQL server (npm run db:local),
# which runs real PostgreSQL binaries from the embedded-postgres package:
#   postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Production (Supabase): the POOLED connection string from Project Settings →
# Database → Connection string (Supavisor, port 6543). Run migrations and the
# seed with the DIRECT string instead (db.<project-ref>.supabase.co, port 5432)
# — see "Deployment" in the README.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Secret used to sign staff session tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Password given to the seeded demo staff account.
# Optional for a local database, where it falls back to the demo password
# documented in the README. REQUIRED for any non-local database: the seed
# refuses to create an account with a published password on a deployed system.
SEED_STAFF_PASSWORD="DemoStaff2026!"

# --- Optional. Sensible defaults apply when these are unset. ---

# The seed deletes every row before writing demo data, so it refuses to run
# against a non-local database unless this is set to exactly "yes". Set it for
# that one command only; never leave it in a shared environment.
# ALLOW_DESTRUCTIVE_SEED="yes"

# Where the bundled local PostgreSQL listens and stores its data
# (npm run db:local). Defaults: 5433 and .postgres
# LOCAL_DB_PORT="5433"
# LOCAL_DB_DIR=".postgres"

# Point the test suite at an existing PostgreSQL instead of starting its own.
# CI sets this to a service container; leave it unset locally.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shipment_tracking_test"

# Run the end-to-end suite against an already-running application rather than
# letting Playwright start one.
# E2E_BASE_URL="http://localhost:3000"
